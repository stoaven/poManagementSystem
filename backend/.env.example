# 数据库连接（MySQL 8，utf8mb4）
#
# 口令必须与你的 MySQL 一致：
#   - 用 docker-compose 起的库：root / root
#   - 用本机自装的 MySQL：按你设置的 root 口令改（未设口令则留空，即 root:@127.0.0.1）
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/shipment_mgmt?charset=utf8mb4

# JWT 签名密钥：生产环境务必替换为随机长字符串
JWT_SECRET=change-me-to-a-long-random-string

# 访问令牌有效期（分钟）
JWT_EXPIRE_MINUTES=120

# 允许的前端来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173
