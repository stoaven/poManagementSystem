# Docker 路线的线上配置：复制成 deploy/.env.prod 后按需修改
# 用法：docker compose --env-file deploy/.env.prod -f deploy/docker-compose.prod.yml up -d --build

# MySQL root 口令（同时用于 compose 的 db 服务与后端的连接串）
MYSQL_ROOT_PASSWORD=改成你自己的强口令
MYSQL_DATABASE=shipment_mgmt

# JWT 签名密钥：换成随机长字符串（改了会让所有人重新登录）
# 生成：openssl rand -hex 32
JWT_SECRET=改成随机长字符串

# 允许的前端来源（同源部署时留空即可）
CORS_ORIGINS=

# 对外暴露的端口
HTTP_PORT=80
